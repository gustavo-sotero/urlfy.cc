<?xml version="1.0"?>
<clickhouse>
    <!-- 
    Windows/Docker Desktop IPv6 Compatibility Fix
    Force all network listeners to use IPv4 only (0.0.0.0) instead of IPv6 (::)
    -->
    
    <!-- Primary IPv4 listener -->
    <listen_host>0.0.0.0</listen_host>
    
    <!-- Explicitly disable default network settings that try IPv6 -->
    <networks>
        <ip>::/0</ip>
    </networks>
    
    <!-- Standard ports (all on IPv4 0.0.0.0) -->
    <http_port>8123</http_port>
    <tcp_port>9000</tcp_port>
    <interserver_http_port>9009</interserver_http_port>
    <mysql_port>9004</mysql_port>
    <postgresql_port>9005</postgresql_port>
</clickhouse>
