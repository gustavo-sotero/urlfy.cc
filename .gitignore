# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
.next/
out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.production
.env.test
!.env.example
# vercel
.vercel
opencode.json
# typescript
*.tsbuildinfo
next-env.d.ts

# tsc emit artifacts (project uses noEmit; these should never be committed)
src/messages/**/*.js
src/messages/**/*.d.ts
src/messages/**/*.d.ts.map
.serena
.turbo/
.github/instructions
.github/prompts
.github/copilot-instructions.md
dist/
node_modules/
playwright-report/
test-results/