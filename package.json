{
  "name": "urlfy.cc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun run --bun next dev",
    "build": "bun run --bun next build",
    "start": "bun run --bun next start",
    "lint": "biome check --write",
    "type-check": "tsc --noEmit",
    "format": "biome format --write",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:unit": "bun test src/",
    "test:integration": "bun test tests/integration/",
    "test:redirect": "bun test src/server/services/__tests__/redirect.service.test.ts src/server/middleware/__tests__/redirect.middleware.test.ts",
    "docker:up": "cd docker && docker-compose up -d",
    "docker:down": "cd docker && docker-compose down",
    "docker:logs": "cd docker && docker-compose logs -f",
    "docker:build": "cd docker && docker-compose build",
    "docker:restart": "cd docker && docker-compose restart app",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "auth:generate": "bun x @better-auth/cli generate --config ./src/lib/auth.cli.ts"
  },
  "dependencies": {
    "@elysiajs/swagger": "^1.3.1",
    "@maxmind/geoip2-node": "^6.3.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.67.3",
    "@opentelemetry/exporter-logs-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.208.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.208.0",
    "@opentelemetry/resources": "^2.2.0",
    "@opentelemetry/sdk-logs": "^0.208.0",
    "@opentelemetry/sdk-metrics": "^2.2.0",
    "@opentelemetry/sdk-node": "^0.208.0",
    "@opentelemetry/semantic-conventions": "^1.38.0",
    "better-auth": "^1.4.10",
    "bullmq": "^5.66.4",
    "cron": "^4.4.0",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.21",
    "ioredis": "^5.9.0",
    "isomorphic-dompurify": "^2.35.0",
    "nanoid": "^5.1.6",
    "next": "16.1.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ua-parser-js": "^2.0.7",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.0",
    "@tailwindcss/postcss": "^4",
    "@types/cron": "^2.4.3",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ua-parser-js": "^0.7.39",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "^1.3.5",
    "drizzle-kit": "^0.31.8",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
