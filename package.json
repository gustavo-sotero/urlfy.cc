{
  "name": "urlfy-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "NODE_ENV=development turbo run dev --parallel",
    "dev:web": "NODE_ENV=development turbo run dev --filter=web",
    "dev:api": "NODE_ENV=development turbo run dev --filter=@urlfy/api",
    "dev:worker": "NODE_ENV=development turbo run dev --filter=worker",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=@urlfy/api",
    "build:worker": "turbo run build --filter=worker",
    "start": "turbo run start --parallel",
    "start:web": "turbo run start --filter=web",
    "start:api": "turbo run start --filter=@urlfy/api",
    "start:worker": "turbo run start --filter=worker",
    "lint": "turbo run lint --concurrency=6 --log-order=stream && bun run scripts/validate-module-boundaries.ts && bun run scripts/validate-proxy-headers.ts",
    "type-check": "turbo run type-check --concurrency=6",
    "format": "bunx biome format . --write --unsafe",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:security": "turbo run test:security",
    "test:perf": "turbo run test:perf",
    "test:load": "bun run scripts/run-k6.ts load/k6/redirect-hot-path.js",
    "test:redirect": "bun test apps/web/src/server/services/__tests__/redirect.service.test.ts",
    "test:e2e": "bunx playwright test",
    "check:secrets": "bun run scripts/check-test-secrets.ts",
    "security:report": "bun run scripts/security-report.ts",
    "security:audit": "bun audit --production",
    "security:check": "bun run scripts/check-test-secrets.ts && bun audit --production",
    "security:test-secrets": "bun run scripts/check-test-secrets.ts",
    "security:scan": "snyk test",
    "docker:up": "cd docker && docker compose up -d",
    "docker:down": "cd docker && docker compose down",
    "docker:logs": "cd docker && docker compose logs -f",
    "docker:build:web": "docker build -f docker/web.Dockerfile -t urlfy-web .",
    "docker:build:api": "docker build -f docker/api.Dockerfile -t urlfy-api .",
    "docker:build:worker": "docker build -f docker/worker.Dockerfile -t urlfy-worker .",
    "docker:geoip": "cd docker && docker compose up geoip-downloader",
    "db:generate": "turbo run db:generate --filter=@urlfy/data",
    "db:migrate": "turbo run db:migrate --filter=@urlfy/data",
    "db:migrate:prod": "bun run --filter @urlfy/data db:migrate:prod",
    "db:push": "turbo run db:push --filter=@urlfy/data",
    "db:studio": "turbo run db:studio --filter=@urlfy/data",
    "db:seed": "bun run packages/data/src/scripts/seed-reserved-slugs.ts",
    "db:seed:test-users": "bun run packages/data/src/scripts/seed-test-users.ts",
    "db:seed:analytics": "bun run packages/data/src/scripts/seed-analytics.ts",
    "db:validate": "bun run scripts/validate-migrations.ts",
    "db:validate:strict": "bun run scripts/validate-migrations.ts --strict",
    "auth:generate": "bunx @better-auth/cli@1.5.4 generate --config ./apps/api/src/lib/auth.cli.ts --output ./packages/data/src/schema/initial.auth.ts --yes"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.3",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/eden": "^1.4.8",
    "@elysiajs/jwt": "^1.4.1",
    "@elysiajs/openapi": "^1.4.14",
    "@elysiajs/opentelemetry": "^1.4.10",
    "@hookform/resolvers": "^5.2.2",
    "@labzzhq/compressor": "^1.1.1",
    "@logtape/drizzle-orm": "^2.0.4",
    "@logtape/elysia": "^2.0.4",
    "@logtape/logtape": "^2.0.4",
    "@logtape/otel": "^2.0.4",
    "@logtape/redaction": "^2.0.4",
    "@maxmind/geoip2-node": "^6.3.4",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.71.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.213.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.213.0",
    "@opentelemetry/resources": "^2.6.0",
    "@opentelemetry/sdk-logs": "^0.213.0",
    "@opentelemetry/sdk-metrics": "^2.6.0",
    "@opentelemetry/sdk-node": "^0.213.0",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-focus-scope": "^1.1.8",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.4",
    "@tanstack/react-query": "^5.90.21",
    "better-auth": "1.5.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron": "^4.4.0",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.1",
    "elysia": "^1.4.27",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "isomorphic-dompurify": "^3.1.0",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.6",
    "next": "^16.1.6",
    "next-intl": "^4.8.3",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.71.2",
    "react-resizable-panels": "^4.7.2",
    "recharts": "^3.8.0",
    "resend": "^6.9.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "ua-parser-js": "^2.0.9",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "turbo": "^2.8.14",
    "@biomejs/biome": "2.4.6",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.2.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.10",
    "@types/cron": "^2.4.3",
    "@types/node": "^25.4.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ua-parser-js": "^0.7.39",
    "babel-plugin-react-compiler": "1.0.0",
    "bun-types": "^1.3.10",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.9",
    "happy-dom": "^20.8.3",
    "openapi-types": "^12.1.3",
    "picocolors": "^1.1.1",
    "postgres": "^3.4.8",
    "snyk": "^1.1303.1",
    "source-map-js": "^1.2.1",
    "tailwindcss": "^4.2.1",
    "postcss": "^8.5.8",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "@swc/core",
    "esbuild",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "snyk",
    "unrs-resolver"
  ],
  "overrides": {
    "@hono/node-server": "^1.19.11",
    "dompurify": "^3.3.2",
    "esbuild": "^0.25.0",
    "file-type": "^21.3.1",
    "hono": "^4.12.7",
    "lodash": "^4.17.23",
    "mailparser": "^3.9.3"
  }
}
