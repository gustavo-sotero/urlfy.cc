{
  "name": "@urlfy/api",
  "version": "0.1.0",
  "private": true,
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "NODE_ENV=development bun run ../../scripts/run-api-dev.ts",
    "start": "bun --env-file=../../.env run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "bunx biome check . --write",
    "type-check": "bunx tsc --noEmit",
    "test": "bun test src/ tests/unit tests/integration tests/perf tests/security",
    "test:unit": "bun test src/ tests/unit/",
    "test:integration": "bun test tests/integration/",
    "test:security": "bun test tests/security/",
    "test:perf": "bun test tests/perf/"
  },
  "dependencies": {
    "@urlfy/auth-shared": "workspace:*",
    "@urlfy/cache": "workspace:*",
    "@urlfy/contracts": "workspace:*",
    "@urlfy/data": "workspace:*",
    "@urlfy/telemetry": "workspace:*",
    "@elysiajs/bearer": "^1.4.2",
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/jwt": "^1.4.0",
    "@elysiajs/openapi": "^1.4.14",
    "@elysiajs/opentelemetry": "^1.4.10",
    "@labzzhq/compressor": "^1.1.1",
    "@logtape/drizzle-orm": "^2.0.2",
    "@logtape/elysia": "^2.0.2",
    "@maxmind/geoip2-node": "^6.3.4",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/instrumentation-pg": "^0.56.0",
    "@opentelemetry/instrumentation-redis-4": "^0.48.0",
    "@opentelemetry/sdk-node": "^0.211.0",
    "better-auth": "^1.5.4",
    "elysia": "^1.4.22",
    "isomorphic-dompurify": "^2.35.0",
    "jose": "^6.0.0",
    "nanoid": "^5.1.6",
    "nodemailer": "^7.0.3",
    "openapi-types": "^12.1.3",
    "otpauth": "^9.4.0",
    "qrcode": "^1.5.4",
    "resend": "^6.9.2",
    "ua-parser-js": "^2.0.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@urlfy/config-ts": "workspace:*",
    "@biomejs/biome": "2.2.0",
    "@types/bun": "^1.3.6",
    "@types/nodemailer": "^6.4.17",
    "@types/node": "^25.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/ua-parser-js": "^0.7.39",
    "bun-types": "^1.3.7",
    "typescript": "^5.9.3"
  }
}
