{
  "name": "@urlfy/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "DEV_API_PROXY_TARGET=http://127.0.0.1:3001 NODE_ENV=development bun --env-file=../../.env --bun next dev",
    "build": "SKIP_ENV_VALIDATION=1 bun --bun next build && bun ./scripts/post-build.ts",
    "start": "bun --env-file=../../.env --bun next start",
    "lint": "bunx biome check . --write",
    "type-check": "bunx tsc --noEmit",
    "test": "bun test --preload ./tests/setup.ts src/ tests/unit tests/integration tests/perf tests/security",
    "test:unit": "bun test --preload ./tests/setup.ts src/ tests/unit/",
    "test:integration": "bun test --preload ./tests/setup.ts tests/integration/",
    "test:security": "bun test --preload ./tests/setup.ts tests/security/",
    "test:perf": "bun test --preload ./tests/setup.ts tests/perf/",
    "test:e2e": "bunx playwright test"
  },
