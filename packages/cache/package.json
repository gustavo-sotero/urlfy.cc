{
  "name": "@urlfy/cache",
  "version": "0.0.0",
  "private": true,
  "description": "Redis client, cache key builders and distributed lock utilities for urlfy.cc",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts",
    "./keys": "./src/keys.ts",
    "./stream": "./src/stream.ts",
    "./circuit-breaker": "./src/circuit-breaker.ts",
    "./distributed-lock": "./src/distributed-lock.ts",
    "./mock": "./src/mock.ts",
    "./metrics-service": "./src/metrics-service.ts",
    "./anti-abuse-service": "./src/anti-abuse-service.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "test": "bun test src/",
    "test:unit": "bun test src/__tests__/",
    "type-check": "bunx tsc --noEmit",
    "lint": "bunx biome check . --write"
  },
  "dependencies": {
    "@urlfy/telemetry": "workspace:*"
  },
  "devDependencies": {
    "@urlfy/config-ts": "workspace:*"
