# ═══════════════════════════════════════════════════════════════════
# urlfy.cc - Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL)
# ═══════════════════════════════════════════════════════════════════
# Required by BOTH apps/api AND apps/web at runtime.
# apps/web uses DATABASE_URL for redirect resolution on cache miss
# (via @urlfy/redirect-domain → @urlfy/data).
DATABASE_URL=postgres://urlfy:urlfy@localhost:5432/urlfy
# For Docker Compose, use postgres as host:
# DATABASE_URL=postgres://urlfy:urlfy@postgres:5432/urlfy
# For production, use a strong password:
# DATABASE_URL=postgres://urlfy:STRONG_PASSWORD_HERE@postgres:5432/urlfy

# ═══════════════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════════════
# REDIS_URL takes precedence when non-blank.
# In Dokploy/Compose, you can leave REDIS_URL empty and provide REDIS_HOST/
# REDIS_PORT instead; runtime will compose redis://REDIS_HOST:REDIS_PORT.
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ═══════════════════════════════════════════════════════════════════
# PROXY TRUST (critical for correct IP extraction)
# ═══════════════════════════════════════════════════════════════════
# Controls whether X-Forwarded-For / X-Real-IP headers are trusted
# for client IP extraction (rate limiting, analytics, anti-abuse).
#
# Set to "true" when running behind a trusted reverse proxy (nginx, Caddy,
# Cloudflare, Dokploy load balancer) that sets these headers correctly.
#
# WARNING: Do NOT set to "true" if the application is directly exposed
# to the internet without a reverse proxy. Doing so allows clients to
# spoof their IP address and bypass rate limiting / IP bans.
#
# Default behaviour (unset or "false"): uses socket/CF-Connecting-IP only.
TRUST_PROXY=false
# For Docker Compose behind a reverse proxy:
# TRUST_PROXY=true

# ═══════════════════════════════════════════════════════════════════
# OPENTELEMETRY (OTLP / Grafana LGTM / SigNoz / any OTLP collector)
# ═══════════════════════════════════════════════════════════════════
# Set TELEMETRY_ENABLED=true to enable telemetry (traces, metrics, logs).
# The application exports all three signals via OTLP HTTP.
TELEMETRY_ENABLED=false

# ── Base endpoint (used for all signals when per-signal overrides are absent) ──
# Must be the collector OTLP HTTP base URL, WITHOUT a /v1/* signal path suffix.
# The application appends /v1/logs, /v1/metrics, and /v1/traces automatically.
# Trailing slashes are normalized — both forms below are equivalent and correct:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/
#
# For self-hosted Grafana LGTM (grafana/otel-lgtm Docker image):
#   OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.urlfy.cc
# For local dev with grafana/otel-lgtm container on port 4318:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://lgtm:4318
# For SigNoz:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── Per-signal endpoint overrides (optional) ────────────────────────────────
# When set, each override is used as-is for that signal (no suffix is appended).
# Use these when different signals go to different backends, or when you need
# to specify the full signal URL directly (e.g. custom routing, debugging).
# If unset, the base endpoint above is used for all three signals.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=https://collector.urlfy.cc/v1/logs
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=https://collector.urlfy.cc/v1/metrics
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://collector.urlfy.cc/v1/traces

# ── OTLP headers (optional) ─────────────────────────────────────────────────
# Comma-separated key=value pairs sent as HTTP headers with every OTLP request.
# Example for Grafana Cloud or collectors requiring auth:
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64>,X-Scope-OrgID=default
# Signal-specific headers merge on top of OTEL_EXPORTER_OTLP_HEADERS and win on conflicts.
# OTEL_EXPORTER_OTLP_LOGS_HEADERS=X-Scope-OrgID=logs
# OTEL_EXPORTER_OTLP_METRICS_HEADERS=X-Scope-OrgID=metrics
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=X-Scope-OrgID=traces
OTEL_EXPORTER_OTLP_HEADERS=

# ── Service identity ────────────────────────────────────────────────────────
# OTEL_SERVICE_NAME is overridden per service in docker-compose (api/web/worker).
# OTEL_SERVICE_VERSION takes priority over the npm package version embedded at build.
OTEL_SERVICE_NAME=urlfy-api
OTEL_SERVICE_VERSION=0.1.0

# ── Debugging ───────────────────────────────────────────────────────────────
# OTEL_DEBUG=true enables verbose OTel SDK internal diagnostics (dev only).
# OTEL_DEBUG=false

# ═══════════════════════════════════════════════════════════════════
# GEOIP (Auto-Download, No Credentials Required)
# ═══════════════════════════════════════════════════════════════════

# Path to GeoLite2-City MMDB file
GEOIP_DB_PATH=/app/geoip/GeoLite2-City.mmdb

# Maximum age in days before re-downloading (default: 25)
GEOIP_MAX_AGE_DAYS=25

# Mirror URL for MMDB download (uses jsDelivr CDN by default)
GEOIP_MMDB_URL=https://cdn.jsdelivr.net/npm/geolite2-city/GeoLite2-City.mmdb.gz

# Note: No MaxMind credentials needed! The downloader uses a public mirror.
# Monthly auto-refresh runs on the 1st day of each month at 00:00 UTC.

# ═══════════════════════════════════════════════════════════════════
# BACKUP
# ═══════════════════════════════════════════════════════════════════
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=/backups

# ═══════════════════════════════════════════════════════════════════
# BETTER-AUTH (Module 2 - Authentication)
# ═══════════════════════════════════════════════════════════════════
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-min-32-chars-change-this
BETTER_AUTH_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════
# INTERNAL API SECRET (Edge Middleware → Node.js API)
# ═══════════════════════════════════════════════════════════════════
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your-internal-api-secret-change-this
API_INTERNAL_URL=http://localhost:3001

# ═══════════════════════════════════════════════════════════════════
# JWT SECRET (password-protected links)
# ═══════════════════════════════════════════════════════════════════
# Required in production for password-protected link verification.
# Generate with: openssl rand -base64 32
# JWT_SECRET=your-jwt-secret-min-32-chars-change-this

# Internal analytics secret should differ from BETTER_AUTH_SECRET in production
# INTERNAL_ANALYTICS_SECRET=your-analytics-internal-secret-change-this

# ═══════════════════════════════════════════════════════════════════
# OAUTH - GOOGLE (Optional)
# ═══════════════════════════════════════════════════════════════════
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ═══════════════════════════════════════════════════════════════════
# OAUTH - GITHUB (Optional)
# ═══════════════════════════════════════════════════════════════════
# Get credentials from: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ═══════════════════════════════════════════════════════════════════
# ADMIN AUTHORITY
# ═══════════════════════════════════════════════════════════════════
# Numeric GitHub account ID of the admin user.
# Find your ID at: https://api.github.com/users/<your-username>
# Must match the `accountId` stored in the Better Auth `account` table
# for the GitHub OAuth provider. When unset, admin access is disabled.
# ADMIN_GITHUB_ACCOUNT_ID=12345678

# ═══════════════════════════════════════════════════════════════════
# EMAIL - SMTP (Optional, for email verification and password reset)
# ═══════════════════════════════════════════════════════════════════
# RESEND_API_KEY=re_...
# RESEND_FROM=noreply@urlfy.cc

# ═══════════════════════════════════════════════════════════════════
# TRUSTED ORIGINS (comma-separated, for production CORS)
# ═══════════════════════════════════════════════════════════════════
# TRUSTED_ORIGINS=https://urlfy.cc,https://www.urlfy.cc

