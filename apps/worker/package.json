{
  "name": "worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development bun --env-file=../../.env run --watch src/index.ts",
    "healthcheck": "bun --env-file=../../.env run src/healthcheck.ts",
    "start": "bun --env-file=../../.env run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "bunx biome check . --write",
    "type-check": "bunx tsc --noEmit",
    "test": "bun test src/",
    "test:unit": "bun test src/"
  },
  "dependencies": {
    "@urlfy/cache": "workspace:*",
    "@urlfy/contracts": "workspace:*",
    "@urlfy/data": "workspace:*",
    "@urlfy/geoip": "workspace:*",
    "@urlfy/telemetry": "workspace:*",
    "ua-parser-js": "^2.0.9",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@urlfy/config-ts": "workspace:*",
    "@biomejs/biome": "2.4.6",
    "@types/bun": "^1.3.10",
    "@types/node": "^25.4.0",
    "@types/ua-parser-js": "^0.7.39",
    "bun-types": "^1.3.10",
    "typescript": "^5.9.3"
  }
}
