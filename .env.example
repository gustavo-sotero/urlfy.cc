# ═══════════════════════════════════════════════════════════════════
# urlfy.cc - Environment Variables
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=3000
HOSTNAME=0.0.0.0
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL)
# ═══════════════════════════════════════════════════════════════════
# For Docker Compose, use postgres as host
DATABASE_URL=postgres://urlfy:urlfy@postgres:5432/urlfy
# For local development (without Docker), use localhost:
# DATABASE_URL=postgres://urlfy:urlfy@localhost:5432/urlfy
# For production, use a strong password:
# DATABASE_URL=postgres://urlfy:STRONG_PASSWORD_HERE@postgres:5432/urlfy

# ═══════════════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════════════
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ═══════════════════════════════════════════════════════════════════
# OPENTELEMETRY / SIGNOZ
# ═══════════════════════════════════════════════════════════════════
# Set OTEL_ENABLED=true to enable telemetry or provide OTEL_EXPORTER_OTLP_ENDPOINT
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=urlfy-api
OTEL_SERVICE_VERSION=0.1.0

# ═══════════════════════════════════════════════════════════════════
# GEOIP (Auto-Download, No Credentials Required)
# ═══════════════════════════════════════════════════════════════════

# Path to GeoLite2-City MMDB file
GEOIP_DB_PATH=/app/geoip/GeoLite2-City.mmdb

# Maximum age in days before re-downloading (default: 25)
GEOIP_MAX_AGE_DAYS=25

# Mirror URL for MMDB download (uses jsDelivr CDN by default)
GEOIP_MMDB_URL=https://cdn.jsdelivr.net/npm/geolite2-city/GeoLite2-City.mmdb.gz

# Note: No MaxMind credentials needed! The downloader uses a public mirror.
# Monthly auto-refresh runs on the 1st day of each month at 00:00 UTC.

# ═══════════════════════════════════════════════════════════════════
# BACKUP
# ═══════════════════════════════════════════════════════════════════
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=/backups

# ═══════════════════════════════════════════════════════════════════
# ADMIN (Temporary - will be replaced by Better-Auth in Module 2)
# ═══════════════════════════════════════════════════════════════════
# Generate a secure key: openssl rand -hex 32
ADMIN_API_KEY=dev_admin_key_replace_in_production

# ═══════════════════════════════════════════════════════════════════
# BETTER-AUTH (Module 2 - Authentication)
# ═══════════════════════════════════════════════════════════════════
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-super-secret-key-min-32-chars-change-this
BETTER_AUTH_URL=http://localhost:3000

# ═══════════════════════════════════════════════════════════════════
# INTERNAL API SECRET (Edge Middleware → Node.js API)
# ═══════════════════════════════════════════════════════════════════
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=your-internal-api-secret-change-this

# ═══════════════════════════════════════════════════════════════════
# OAUTH - GOOGLE (Optional)
# ═══════════════════════════════════════════════════════════════════
# Get credentials from: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# ═══════════════════════════════════════════════════════════════════
# OAUTH - GITHUB (Optional)
# ═══════════════════════════════════════════════════════════════════
# Get credentials from: https://github.com/settings/developers
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret

# ═══════════════════════════════════════════════════════════════════
# EMAIL - SMTP (Optional, for email verification and password reset)
# ═══════════════════════════════════════════════════════════════════
# RESEND_API_KEY=re_...
# RESEND_FROM=noreply@urlfy.cc

# ═══════════════════════════════════════════════════════════════════
# TRUSTED ORIGINS (comma-separated, for production CORS)
# ═══════════════════════════════════════════════════════════════════
# TRUSTED_ORIGINS=https://urlfy.cc,https://www.urlfy.cc

