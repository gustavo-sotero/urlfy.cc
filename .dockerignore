# ═══════════════════════════════════════════════════════════════════
# .dockerignore - Optimize Docker build context
# ═══════════════════════════════════════════════════════════════════

# Dependencies (installed fresh in container)
node_modules/
.pnp
.pnp.js

# Next.js build artifacts (rebuilt in container)
.next/
out/

# Testing (not needed in production)
coverage/
.nyc_output/
tests/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Build artifacts
dist/
build/

# Environment files (NEVER include secrets in image)
.env
.env.*
!.env.example

# IDE and Editor
.vscode/
.idea/
*.swp
*.swo
*~
.editorconfig

# OS generated
.DS_Store
Thumbs.db
ehthumbs.db

# Git (not needed in container)
.git/
.gitignore
.gitattributes
.gitmodules

# Documentation (not needed in runtime)
*.md
docs/
CODEBASE_ANALYSIS*.md

# CI/CD (not needed in runtime)
.github/

# Docker files (already in context, prevent recursion)
docker/docker-compose*.yml
docker/README.md

# Logs (should never be in build context)
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# Development tools
.turbo/
.vercel/
.contentlayer/
playwright-report/
test-results/

# Security artifacts
security-report.json
openapi-spec.json

# Cache directories
.cache/
.npm/
.eslintcache
.biome/

# Temporary files
tmp/
temp/
*.tmp
*.temp
