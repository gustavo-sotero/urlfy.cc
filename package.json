{
  "name": "urlfy.cc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"bun run --bun next dev\" \"bun run worker:dev\" --names \"APP,WKR\" -c \"blue,magenta\"",
    "dev:app": "bun run --bun next dev",
    "worker:dev": "bun run --watch src/workers.ts",
    "worker:start": "bun run src/workers.ts",
    "prebuild": "bun run security:test-secrets",
    "build": "bun run --bun next build && bun run scripts/post-build.ts",
    "start": "concurrently \"bun .next/standalone/server.js\" \"bun run worker:start\" --names \"APP,WKR\" -c \"blue,magenta\"",
    "lint": "bunx biome check . --write",
    "type-check": "bunx tsc --noEmit",
    "format": "bunx biome format . --write --unsafe",
    "test": "bun test src/ tests/integration tests/perf tests/security",
    "test:watch": "bun test --watch src/ tests/integration tests/perf tests/security",
    "test:coverage": "bun test --coverage src/ tests/integration tests/perf tests/security",
    "test:unit": "bun test src/",
    "test:integration": "bun test tests/integration/",
    "test:security": "bun test tests/security/",
    "test:e2e": "bunx playwright test",
    "test:e2e:admin": "bunx playwright test tests/e2e/admin-2fa-enforcement.spec.ts",
    "test:redirect": "bun test src/server/services/__tests__/redirect.service.test.ts src/server/middleware/__tests__/redirect.middleware.test.ts",
    "check:secrets": "bun run scripts/check-test-secrets.ts",
    "security:report": "bun run scripts/security-report.ts",
    "security:audit": "bun audit --production",
    "security:check": "bun run security:test-secrets && bun run security:audit",
    "security:test-secrets": "bun run scripts/check-test-secrets.ts",
    "security:scan": "snyk test",
    "docker:up": "cd docker && docker-compose up -d",
    "docker:down": "cd docker && docker-compose down",
    "docker:logs": "cd docker && docker-compose logs -f",
    "docker:build": "cd docker && docker-compose build",
    "docker:restart": "cd docker && docker-compose restart app",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:seed": "bun run src/db/scripts/seed-reserved-slugs.ts",
    "db:seed:test-users": "bun run src/db/scripts/seed-test-users.ts",
    "db:seed:analytics": "bun run src/db/scripts/seed-analytics.ts",
    "auth:generate": "bunx @better-auth/cli generate --config ./src/lib/auth.cli.ts --output ./src/db/schema/initial.auth.ts --yes"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.2",
