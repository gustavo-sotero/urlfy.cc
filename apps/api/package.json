{
  "name": "@urlfy/api",
  "version": "0.1.0",
  "private": true,
  "module": "src/index.ts",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "dev": "cd ../.. && NODE_ENV=development bun --env-file=.env run --watch apps/api/src/index.ts",
    "start": "bun --env-file=../../.env run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "lint": "bunx biome check . --write",
    "type-check": "bunx tsc --noEmit",
    "test": "bun test src/ tests/unit tests/integration tests/perf tests/security && RUN_AUTH_MIDDLEWARE_INFRA_TESTS=true bun test src/server/middleware/__tests__/auth.middleware.test.ts",
    "test:unit": "bun test src/ tests/unit/",
    "test:integration": "bun run scripts/run-integration-tests.ts",
    "test:security": "bun test tests/security/",
    "test:perf": "bun test tests/perf/"
  },
  "dependencies": {
    "@elysiajs/bearer": "^1.4.4",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@elysiajs/opentelemetry": "^1.4.11",
    "@labzzhq/compressor": "^1.1.1",
    "@logtape/drizzle-orm": "catalog:",
    "@logtape/elysia": "^2.3.3",
    "@node-rs/argon2": "^2.2.0",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-redis-4": "^0.49.0",
    "@opentelemetry/sdk-node": "catalog:",
    "@urlfy/auth-shared": "workspace:*",
    "@urlfy/cache": "workspace:*",
    "@urlfy/contracts": "workspace:*",
    "@urlfy/data": "workspace:*",
    "@urlfy/email": "workspace:*",
    "@urlfy/geoip": "workspace:*",
    "@urlfy/redirect-domain": "workspace:*",
    "@urlfy/telemetry": "workspace:*",
    "better-auth": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "file-type": "^21.3.4",
    "jose": "^6.2.11",
    "nanoid": "^6.0.1",
    "nodemailer": "^10.0.0",
    "openapi-types": "^12.1.3",
    "otpauth": "^9.5.2",
    "qrcode": "^1.5.4",
    "resend": "^6.26.0",
    "ua-parser-js": "^2.0.10",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@urlfy/config-ts": "workspace:*",
    "@biomejs/biome": "catalog:tooling",
    "@types/bun": "catalog:tooling",
    "@types/nodemailer": "^8.0.1",
    "@types/node": "catalog:tooling",
    "@types/qrcode": "^1.5.6",
    "@types/ua-parser-js": "^0.7.39",
    "bun-types": "catalog:tooling",
    "typescript": "catalog:tooling"
  }
}
