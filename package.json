{
  "name": "urlfy-monorepo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.1",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@logtape/drizzle-orm": "^2.3.3",
      "@logtape/logtape": "^2.3.3",
      "@logtape/otel": "^2.3.3",
      "@logtape/redaction": "^2.3.3",
      "@opentelemetry/api": "^1.9.1",
      "@opentelemetry/auto-instrumentations-node": "^0.80.0",
      "@opentelemetry/exporter-logs-otlp-http": "^0.222.0",
      "@opentelemetry/exporter-metrics-otlp-http": "^0.222.0",
      "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
      "@opentelemetry/resources": "^2.11.0",
      "@opentelemetry/sdk-logs": "^0.222.0",
      "@opentelemetry/sdk-metrics": "^2.11.0",
      "@opentelemetry/sdk-node": "^0.222.0",
      "@opentelemetry/semantic-conventions": "^1.43.0",
      "better-auth": "1.7.2",
      "drizzle-orm": "^0.45.2",
      "elysia": "^1.4.30"
    },
    "catalogs": {
      "tooling": {
        "@biomejs/biome": "2.5.12",
        "@playwright/test": "^1.62.1",
        "@types/bun": "^1.4.1",
        "@types/cron": "^2.4.3",
        "@types/node": "^26.4.1",
        "bun-types": "^1.4.1",
        "drizzle-kit": "^0.31.10",
        "typescript": "^7.0.2"
      }
    }
  },
  "scripts": {
    "dev:preflight": "bun run scripts/warn-local-api-dist.ts",
    "dev": "bun run dev:preflight && DEV_API_PROXY_TARGET=http://localhost:3001 NODE_ENV=development turbo run dev",
    "dev:web": "bun run dev:preflight && DEV_API_PROXY_TARGET=http://localhost:3001 NODE_ENV=development turbo run dev --filter=web",
    "dev:api": "bun run dev:preflight && NODE_ENV=development turbo run dev --filter=@urlfy/api",
    "dev:worker": "NODE_ENV=development turbo run dev --filter=worker",
    "build": "turbo run build",
    "build:web": "turbo run build --filter=web",
    "build:api": "turbo run build --filter=@urlfy/api",
    "build:worker": "turbo run build --filter=worker",
    "start": "turbo run start",
    "start:web": "turbo run start --filter=web",
    "start:api": "turbo run start --filter=@urlfy/api",
    "start:worker": "turbo run start --filter=worker",
    "lint": "bun scripts/run-lint-pipeline.ts",
    "type-check": "turbo run type-check --concurrency=6",
    "format": "bunx biome format . --write",
    "validate:catalog": "bun run scripts/validate-workspace-catalog.ts",
    "openapi:generate": "bun --cwd apps/api ./scripts/export-openapi.ts --write",
    "openapi:check": "bun --cwd apps/api ./scripts/export-openapi.ts --check",
    "contracts:generate": "bun run openapi:generate && bun run scripts/generate-api-contracts.ts --write",
    "contracts:check": "bun run openapi:check && bun run scripts/generate-api-contracts.ts --check",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "turbo run test:integration",
    "test:security": "turbo run test:security",
    "test:security:web-live": "bun run scripts/run-live-web-security-suite.ts",
    "test:perf": "turbo run test:perf",
    "test:redirect": "bun test apps/web/src/server/services/__tests__/redirect.service.test.ts",
    "test:e2e": "bunx playwright test",
    "check:secrets": "bun run scripts/check-test-secrets.ts",
    "security:report": "bun run scripts/security-report.ts",
    "security:audit": "bun audit --production",
    "security:check": "bun run scripts/check-test-secrets.ts && bun run validate:catalog && bun audit --production",
    "security:test-secrets": "bun run scripts/check-test-secrets.ts",
    "security:scan": "snyk test",
    "docker:up": "cd docker && docker compose up -d",
    "docker:down": "cd docker && docker compose down",
    "docker:logs": "cd docker && docker compose logs -f",
    "docker:build:web": "docker build -f docker/web.Dockerfile -t urlfy-web .",
    "docker:build:api": "docker build -f docker/api.Dockerfile -t urlfy-api .",
    "docker:build:worker": "docker build --target worker-runtime -f docker/worker.Dockerfile -t urlfy-worker .",
    "docker:build:migrate": "docker build --target migrate-runtime -f docker/worker.Dockerfile -t urlfy-migrate .",
    "docker:geoip": "cd docker && docker compose up geoip-downloader",
    "db:generate": "turbo run db:generate --filter=@urlfy/data",
    "db:migrate": "turbo run db:migrate --filter=@urlfy/data",
    "db:migrate:prod": "bun run --filter @urlfy/data db:migrate:prod",
    "db:push": "turbo run db:push --filter=@urlfy/data",
    "db:studio": "turbo run db:studio --filter=@urlfy/data",
    "db:validate:aliases": "bun run scripts/validate-link-alias-policy.ts",
    "db:seed": "bun run packages/data/src/scripts/seed-reserved-slugs.ts",
    "db:seed:test-users": "bun run packages/data/src/scripts/seed-test-users.ts",
    "db:seed:analytics": "bun run packages/data/src/scripts/seed-analytics.ts",
    "db:validate": "bun run scripts/validate-migrations.ts",
    "db:validate:strict": "bun run scripts/validate-migrations.ts --strict",
    "auth:generate": "bunx @better-auth/cli@1.6.11 generate --config ./apps/api/src/lib/auth.cli.ts --output ./packages/data/src/schema/initial.auth.ts --yes"
  },
  "dependencies": {
    "@opentelemetry/otlp-transformer": "^0.222.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@playwright/test": "^1.62.1",
    "@types/bun": "^1.4.1",
    "@types/node": "^26.4.1",
    "@typescript/typescript6": "6.0.2",
    "bun-types": "^1.4.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "lefthook": "^2.1.12",
    "snyk": "^1.1307.0",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@parcel/watcher",
    "lefthook",
    "@swc/core",
    "esbuild",
    "msgpackr-extract",
    "protobufjs",
    "sharp",
    "snyk",
    "unrs-resolver"
  ],
  "overrides": {
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-prometheus": "^0.222.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@protobufjs/utf8": "^1.1.1",
    "@hono/node-server": "^1.19.13",
    "defu": "^6.1.7",
    "dompurify": "^3.4.0",
    "esbuild": "^0.25.0",
    "effect": "^3.21.0",
    "file-type": "^21.3.2",
    "hono": "^4.12.18",
    "kysely": "^0.28.17",
    "lodash": "^4.18.1",
    "mailparser": "^3.9.3",
    "picomatch": "^4.0.4",
    "protobufjs": "^7.5.8",
    "postcss": "^8.5.10",
    "uuid": "^14.0.0",
    "yaml": "^2.8.3",
    "ws": "^8.20.1"
  }
}
