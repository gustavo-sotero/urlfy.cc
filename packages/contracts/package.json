{
  "name": "@urlfy/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "Shared types, DTOs and API envelopes for urlfy.cc",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./analytics": "./src/analytics.types.ts",
    "./alias-policy": "./src/alias-policy.ts",
    "./api-client": "./src/api-client.ts",
    "./api-keys": "./src/api-keys.types.ts",
    "./auth": "./src/auth.types.ts",
    "./links": "./src/links.types.ts",
    "./redirect": "./src/redirect.types.ts",
    "./security": "./src/security.types.ts",
    "./generated": "./src/generated/api.ts"
  },
  "scripts": {
    "contracts:check": "cd ../.. && bun run scripts/generate-api-contracts.ts --check",
    "contracts:generate": "cd ../.. && bun run scripts/generate-api-contracts.ts --write",
    "test": "bun test tests/unit/",
    "test:unit": "bun test tests/unit/",
    "type-check": "bunx tsc --noEmit",
    "lint": "bunx biome check . --write"
  },
  "dependencies": {
    "@urlfy/auth-shared": "workspace:*"
  },
  "devDependencies": {
    "@urlfy/config-ts": "workspace:*"
  }
}
