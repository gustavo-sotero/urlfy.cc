{
  "title": "Analytics Engine Dashboard",
  "description": "Monitoring for urlfy.cc analytics processing pipeline",
  "panels": [
    {
      "id": 1,
      "title": "Jobs Processed (Rate)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "rate(analytics_jobs_processed_total[5m])",
          "legendFormat": "Jobs/sec"
        }
      ]
    },
    {
      "id": 2,
      "title": "Jobs Failed (Rate)",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "rate(analytics_jobs_failed_total[5m])",
          "legendFormat": "Failed/sec"
        }
      ]
    },
    {
      "id": 3,
      "title": "Queue Depth",
      "type": "gauge",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 6 },
      "targets": [
        {
          "expr": "queue_pending{queue=\"analytics\"}",
          "legendFormat": "Pending Jobs"
        }
      ],
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "value": 0, "color": "green" },
          { "value": 100, "color": "yellow" },
          { "value": 500, "color": "red" }
        ]
      }
    },
    {
      "id": 4,
      "title": "Job Processing Time (P50, P95, P99)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, rate(analytics_job_processing_time_bucket[5m]))",
          "legendFormat": "P50"
        },
        {
          "expr": "histogram_quantile(0.95, rate(analytics_job_processing_time_bucket[5m]))",
          "legendFormat": "P95"
        },
        {
          "expr": "histogram_quantile(0.99, rate(analytics_job_processing_time_bucket[5m]))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 5,
      "title": "GeoIP Lookup Time",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(analytics_geoip_lookup_time_bucket[5m]))",
          "legendFormat": "P95 GeoIP"
        }
      ]
    },
    {
      "id": 6,
      "title": "Dead Letter Queue Size",
      "type": "stat",
      "gridPos": { "x": 0, "y": 12, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "queue_pending{queue=\"analytics:dead\"}",
          "legendFormat": "DLQ Size"
        }
      ],
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "value": 0, "color": "green" },
          { "value": 10, "color": "yellow" },
          { "value": 50, "color": "red" }
        ]
      }
    },
    {
      "id": 7,
      "title": "Events Inserted (Rate)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 12, "w": 9, "h": 4 },
      "targets": [
        {
          "expr": "rate(analytics_events_inserted_total[5m]) * 60",
          "legendFormat": "Events/min"
        }
      ]
    },
    {
      "id": 8,
      "title": "Aggregation Jobs Completed",
      "type": "stat",
      "gridPos": { "x": 15, "y": 12, "w": 4, "h": 4 },
      "targets": [
        {
          "expr": "analytics_aggregations_completed_total",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 9,
      "title": "Cleanup Jobs Completed",
      "type": "stat",
      "gridPos": { "x": 19, "y": 12, "w": 5, "h": 4 },
      "targets": [
        {
          "expr": "analytics_cleanup_completed_total",
          "legendFormat": "Total"
        }
      ]
    },
    {
      "id": 10,
      "title": "Event Enrichment Time (P95)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(analytics_event_enrichment_time_bucket[5m]))",
          "legendFormat": "Enrichment P95"
        }
      ]
    },
    {
      "id": 11,
      "title": "Worker Concurrency Utilization",
      "type": "gauge",
      "gridPos": { "x": 12, "y": 16, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "queue_active{queue=\"analytics\"} / 50 * 100",
          "legendFormat": "% Utilization"
        }
      ],
      "unit": "percent"
    },
    {
      "id": 12,
      "title": "Error Rate",
      "type": "stat",
      "gridPos": { "x": 18, "y": 16, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "rate(analytics_jobs_failed_total[5m]) / rate(analytics_jobs_processed_total[5m]) * 100",
          "legendFormat": "Error %"
        }
      ],
      "thresholds": {
        "mode": "absolute",
        "steps": [
          { "value": 0, "color": "green" },
          { "value": 1, "color": "yellow" },
          { "value": 5, "color": "red" }
        ]
      },
      "unit": "percent"
    }
  ],
  "alerts": [
    {
      "name": "High DLQ Size",
      "condition": "queue_pending{queue=\"analytics:dead\"} > 50",
      "severity": "warning",
      "message": "Dead Letter Queue has more than 50 failed jobs"
    },
    {
      "name": "High Error Rate",
      "condition": "rate(analytics_jobs_failed_total[5m]) / rate(analytics_jobs_processed_total[5m]) > 0.05",
      "severity": "critical",
      "message": "Analytics job error rate exceeds 5%"
    },
    {
      "name": "Queue Backlog",
      "condition": "queue_pending{queue=\"analytics\"} > 1000",
      "severity": "warning",
      "message": "Analytics queue has more than 1000 pending jobs"
    },
    {
      "name": "Slow Processing",
      "condition": "histogram_quantile(0.99, rate(analytics_job_processing_time_bucket[5m])) > 1000",
      "severity": "warning",
      "message": "P99 job processing time exceeds 1 second"
    }
  ],
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  }
}
