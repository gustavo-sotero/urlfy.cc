{
  "extends": "@urlfy/config-ts/server",
  "compilerOptions": {
    "paths": {
      "@urlfy/cache": ["../../packages/cache/src/index.ts"],
      "@urlfy/cache/*": ["../../packages/cache/src/*.ts"],
      "@urlfy/contracts": ["../../packages/contracts/src/index.ts"],
      "@urlfy/contracts/*": ["../../packages/contracts/src/*.ts"],
      "@urlfy/data": ["../../packages/data/src/index.ts"],
      "@urlfy/data/*": ["../../packages/data/src/*.ts"],
      "@urlfy/telemetry": ["../../packages/telemetry/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
