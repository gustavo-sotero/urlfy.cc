{
  "name": "@urlfy/data",
  "version": "0.0.0",
  "private": true,
  "description": "Database client, Drizzle ORM schemas and migration utilities for urlfy.cc",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./schema/analytics": "./src/schema/analytics.ts",
    "./schema/audit": "./src/schema/audit.ts",
    "./schema/auth": "./src/schema/auth.ts",
    "./schema/banned-urls": "./src/schema/banned-urls.ts",
    "./schema/contact": "./src/schema/contact.ts",
    "./schema/links": "./src/schema/links.ts",
    "./schema/reserved-slugs": "./src/schema/reserved-slugs.ts",
    "./cli": "./src/cli.ts",
    "./scripts/partition-manager": "./src/scripts/partition-manager.ts"
  },
  "scripts": {
    "type-check": "bunx tsc --noEmit",
    "lint": "bunx biome check . --write",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "db:push": "bunx drizzle-kit push",
    "db:studio": "bunx drizzle-kit studio",
    "db:migrate:prod": "bun run src/scripts/migrate.ts",
    "db:seed": "bun run src/scripts/seed-reserved-slugs.ts",
    "db:seed:test-users": "bun run src/scripts/seed-test-users.ts",
    "db:seed:analytics": "bun run src/scripts/seed-analytics.ts"
  },
  "dependencies": {
    "@logtape/drizzle-orm": "^2.0.2",
    "@urlfy/telemetry": "workspace:*",
    "drizzle-orm": "^0.45.1"
  },
  "devDependencies": {
    "@urlfy/config-ts": "workspace:*",
    "drizzle-kit": "^0.31.8",
    "postgres": "^3.4.8"
  }
}
