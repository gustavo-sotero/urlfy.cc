{
  "name": "@urlfy/telemetry",
  "version": "0.0.0",
  "private": true,
  "description": "Structured logging and tracing utilities for urlfy.cc",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./init": "./src/init.ts",
    "./logger": "./src/logger.ts",
    "./metrics": "./src/metrics.ts"
  },
  "scripts": {
    "type-check": "bunx tsc --noEmit",
    "lint": "bunx biome check . --write",
    "test:unit": "bun test src/"
  },
  "dependencies": {
    "@logtape/logtape": "catalog:",
    "@logtape/otel": "catalog:",
    "@logtape/redaction": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/resources": "catalog:",
    "@opentelemetry/sdk-logs": "catalog:",
    "@opentelemetry/sdk-metrics": "catalog:",
    "@opentelemetry/sdk-node": "catalog:",
    "@opentelemetry/semantic-conventions": "catalog:",
    "@opentelemetry/exporter-trace-otlp-http": "catalog:",
    "@opentelemetry/exporter-metrics-otlp-http": "catalog:",
    "@opentelemetry/exporter-logs-otlp-http": "catalog:",
    "@opentelemetry/auto-instrumentations-node": "catalog:"
  },
  "devDependencies": {
    "@urlfy/config-ts": "workspace:*"
  }
}
